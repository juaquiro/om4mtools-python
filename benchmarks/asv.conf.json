{
    "version": 1,
    "project": "om4mtools-python",
    "project_url": "https://github.com/juaquiro/om4mtools-python",
    "repo": "..",
    "branches": ["develop"],
    "environment_type": "virtualenv",
    "install_command": ["python -m pip install {wheel_file}[dev]"],
    "build_command": ["python -m build --wheel -o {build_cache_dir} {build_dir}"],
    "benchmark_dir": "benchmarks",
    "env_dir": ".asv/env",
    "results_dir": ".asv/results",
    "html_dir": ".asv/html"
}
